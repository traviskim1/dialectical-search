# Copy to .env and fill in. Don't commit .env. Online (Streamlit Cloud), put these in the app's Secrets instead.

# --- Claude API (the default backend; paid from your API credits) ---
ANTHROPIC_API_KEY=
API_MODEL=claude-sonnet-5-5
API_EFFORT=medium

# --- Storage: unset = files in JOURNALS_DIR; set = one Postgres table (Supabase/Neon connection string) ---
DATABASE_URL=

# --- Local model (any OpenAI-compatible server). Check the exact tag with `ollama list`. ---
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3.5:9b

# --- Claude (through the `claude` command and your own plan; for testing by yourself only) ---
CLAUDE_MODEL=claude-sonnet-5-5

# Where journals live (one folder per journal: journal.json, tree.md)
JOURNALS_DIR=journals

# --- Privacy (needed once the app is online) ---
# Which model participants use: api (default) | local | claude | mock
DTR_BACKEND=api
# Unlocks the sidebar (every journal + researcher view) at ?researcher=1. Unset = can't be unlocked.
RESEARCHER_PASSWORD=
